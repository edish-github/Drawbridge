  "routers": [
    {
      "id": "tier",
      "node": "tier_router",
      "monotonic": "scrutiny never falls",
      "branches": [
        {
          "to": "plan",
          "when": "customer data, production access or an AI service",
          "decided_by": "planner.tier_from"
        },
        {
          "to": "plan",
          "when": "internal non-customer data",
          "decided_by": "planner.tier_from"
        },
        {
          "to": "plan",
          "when": "everything else",
          "decided_by": "planner.tier_from"
        }
      ]
    },
    {
      "id": "retier",
      "node": "retier_router",
      "monotonic": "tier only ever rises",
      "branches": [
        {
          "to": "questionnaire_send",
          "when": "an answer widens the declared data scope",
          "decided_by": "retier.reassess_tier"
        },
        {
          "to": "coverage_join",
          "when": "the declared scope still holds",
          "decided_by": "retier.reassess_tier"
        }
      ]
    },
    {
      "id": "relevance",
      "node": "relevance_router",
      "monotonic": "a signal is never un-seen",
      "branches": [
        {
          "to": "rereview",
          "when": "relevant and confidence >= 0.8",
          "decided_by": "watchdog.relevance"
        },
        {
          "to": "needs_human",
          "when": "relevant and confidence below 0.8",
          "decided_by": "watchdog.relevance"
        },
        {
          "to": "monitor",
          "when": "not relevant to this vendor",
          "decided_by": "watchdog.relevance"
        }
      ]
    }
  ],
  "joins": [
    {
      "id": "coverage",
      "node": "coverage_join",
      "mode": "threshold",
      "threshold": 0.9,
      "quorum": null,
      "override": "an analyst marks the reply thread complete",
      "on_shortfall": "wait",
      "arms": [
        {
          "name": "reply_parse",
          "required": true,
          "describes": "answers merged and rated"
        },
        {
          "name": "followup",
          "required": false,
          "describes": "unusable answers re-asked once"
        },
        {
          "name": "chase",
          "required": false,
          "describes": "outstanding questions chased"
        }
      ]
    },
    {
      "id": "findings",
      "node": "findings_join",
      "mode": "all_required",
      "threshold": null,
      "quorum": null,
      "override": null,
      "on_shortfall": "park",
      "arms": [
        {
          "name": "checks",
          "required": true,
          "describes": "arithmetic over extracted dates"
        },
        {
          "name": "cross_exam",
          "required": true,
          "describes": "claims reconciled against passages"
        },
        {
          "name": "subprocessors",
          "required": true,
          "describes": "the fourth-party chain diffed"
        }
      ]
    }
  ],
  "cycles": [
    {
      "id": "chase_rounds",
      "through": [
        "chase"
      ],
      "max_iterations": 3,
      "counted_by": "reviews.chase_round",
      "on_exhaustion": "park at needs_human; a person owns the correspondence",
      "bounded_by": "an explicit round counter"
    },
    {
      "id": "followup_once",
      "through": [
        "reply_parse",
        "followup"
      ],
      "max_iterations": 1,
      "counted_by": "followups.asked",
      "on_exhaustion": "accept the answer as given and let it show as a gap",
      "bounded_by": "one re-ask per answer"
    },
    {
      "id": "retier",
      "through": [
        "reply_parse",
        "retier_router",
        "questionnaire_send"
      ],
      "max_iterations": 2,
      "counted_by": "reviews.plan_version",
      "on_exhaustion": "tier 1 is the ceiling; there is nothing further to raise to",
      "bounded_by": "arithmetic \u2014 three tiers and the tier only ever rises"
    },
    {
      "id": "rereview",
      "through": [
        "monitor",
        "relevance_router",
        "rereview",
        "intake"
      ],
      "max_iterations": 3,
      "counted_by": "reviews.reopened_from chain depth",
      "on_exhaustion": "raise a triage card and open nothing; a person decides whether a fourth automated re-review is the right answer",
      "bounded_by": "a declared budget \u2014 the feed provides no natural one"
    }
  ]
}
