      allow write: if caller() in ['sa-evidence@drawbridge-hack.iam.gserviceaccount.com', 'sa-orchestrator@drawbridge-hack.iam.gserviceaccount.com', 'sa-questionnaire@drawbridge-hack.iam.gserviceaccount.com', 'sa-scorer@drawbridge-hack.iam.gserviceaccount.com', 'sa-watchdog@drawbridge-hack.iam.gserviceaccount.com'];
