# Drawbridge configuration.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never be
# committed. Deployed services read these from Secret Manager, not from a file.
# `shared/config.py` validates every key at import time and fails loudly if one is
# missing, because a service that boots half-configured produces the worst class of
# demo failure.

# --- Project and region -------------------------------------------------------
PROJECT_ID=drawbridge-hack                  # the dedicated GCP project; never an existing one
REGION=us-central1                          # one region for Agent Engine, Run, Firestore, Storage, Pub/Sub

# --- Models -------------------------------------------------------------------
MODEL_FAST=gemini-3.5-flash                 # default: parsing, extraction, classification, chases
MODEL_DEEP=gemini-pro                       # spent in exactly two places: cross-examination and the risk memo
MODEL_EMBED=text-embedding-005              # evidence-chunk embeddings behind the KNN retrieval layer
MODEL_LOCAL=gemma-3                         # in-VPC PII scrubber, runs after screening (stretch)

# --- Storage ------------------------------------------------------------------
BUCKET_QUARANTINE=drawbridge-hack-evidence-quarantine   # raw vendor uploads; only sa-armor holds any role here
BUCKET_CLEAN=drawbridge-hack-evidence-clean             # armor-stamped documents; Evidence agent read-only
BUCKET_BINDERS=drawbridge-hack-binders                  # exported audit binders

# --- Human approval tokens ----------------------------------------------------
# Signing is asymmetric: the private half exists only inside the approval service,
# the gateway is configured with the public half and nothing else, so the gateway can
# recognise a human decision but cannot manufacture one.
APPROVAL_PRIVATE_KEY_SECRET=projects/PROJECT_NUMBER/secrets/drawbridge-approval-key/versions/latest   # approval service only
APPROVAL_PUBLIC_KEY=projects/PROJECT_NUMBER/secrets/drawbridge-approval-pub/versions/latest           # gateway verification only
APPROVAL_TOKEN_SECRET=                      # legacy symmetric key; superseded by the pair above, leave empty

# --- Model Armor --------------------------------------------------------------
MODEL_ARMOR_TEMPLATE_UNTRUSTED=drawbridge-untrusted   # vendor uploads and reply bodies
MODEL_ARMOR_TEMPLATE_OUTPUT=drawbridge-output         # agent-produced memos, findings and outbound mail
ARMOR_FAIL_CLOSED=true                      # mandatory control: unavailable means nothing is promoted

# --- Retrieval ----------------------------------------------------------------
VECTOR_TOP_K=6                              # passages retrieved per questionnaire claim
CHUNK_TOKENS=400                            # evidence chunk size before embedding

# --- Review behaviour ---------------------------------------------------------
PLAN_VERSION=1                              # seed value; incremented on every re-plan after a re-tier
FOLLOWUP_CAP=2                              # targeted follow-ups per question before the fleet stops asking
WATCHDOG_CONFIDENCE_MIN=0.75                # below this a signal is a triage card, not a re-review
COST_CEILING_PER_REVIEW_USD=0.50            # enforced: exceeding it parks the review in NEEDS_HUMAN

# --- Demo ---------------------------------------------------------------------
DEMO_TIME_COMPRESSION=240                   # 1 real second = 4 simulated minutes; 1 disables compression
