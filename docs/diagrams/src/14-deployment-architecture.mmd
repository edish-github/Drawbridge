    SCH["Cloud Scheduler"]
  end

  subgraph COST["COST ENGINEERING — the number no competitor will show"]
    direction LR
    BA["<b>Budget alerts</b> at 50, 100 and 130<br/>of the 150 dollar credit"]
    MIN["<b>Cloud Run</b> min-instances 0<br/>max-instances 2 · CPU throttling on"]
    ROUTE["<b>Flash-first routing</b><br/>Pro only for cross-examine and memo"]
    METER["<b>Per-review meter</b><br/><b>enforced</b> past 1.00 dollars — the review parks<br/>in NEEDS_HUMAN with a cost card. A budget that is<br/>observed rather than enforced is not a control"]
    PUBSAFE["<b>Public surface</b><br/>statically rendered · no model path<br/>rate-limited · max-instances 2"]
    LIFECYCLE["<b>Quarantine lifecycle</b><br/>objects deleted after 7 days"]
    TD["<b>make teardown</b> after the final take<br/>only the demo dashboard stays live"]
  end

