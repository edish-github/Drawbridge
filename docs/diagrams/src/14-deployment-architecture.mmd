    AE["<b>Vertex AI Agent Engine</b><br/>five ADK 2 agents, five identities<br/>plus sa-armor for the screening pipeline<br/>no graph runner holds the review — position is a<br/>checkpoint and an unacknowledged message"]
    CR1["<b>Cloud Run</b> · dashboard"]
    CR2["<b>Cloud Run</b> · vendor portal"]
    CR3["<b>Cloud Run</b> · inbox simulator"]
    CR4["<b>Cloud Run</b> · binder service"]
