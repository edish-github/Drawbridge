  "events": {
    "topics": [
      "review.intake",
      "review.plan_ready",
      "vendor.reply_received",
      "review.chase_due",
      "vendor.evidence_uploaded",
      "evidence.screened",
      "review.findings_ready",
      "review.score_ready",
      "review.approved",
      "review.rescore",
      "watchdog.sweep",
      "watchdog.hit"
    ],
    "max_delivery_attempts": 5,
    "ack_deadline_seconds": 60,
    "out_of_phase": [
      {
        "event": "vendor.reply_received",
        "condition": "review already SCORED",
        "behaviour": "attach to the ledger as an addendum; if it changes an answer that produced a finding, publish review.rescore. Never silently discarded \u2014 the discarded reply is the one the vendor will quote back."
      },
      {
        "event": "evidence.screened",
        "condition": "no plan exists yet",
        "behaviour": "park the message and retry with backoff; dead-letter after five attempts"
      },
      {
        "event": "watchdog.hit",
        "condition": "review already reopened",
        "behaviour": "deduplicate on signal id"
      },
      {
        "event": "any",
        "condition": "review is DECIDED",
        "behaviour": "append to the ledger, never mutate. A decided review is immutable; a new signal opens a new linked review rather than editing a closed one."
      }
    ]
  },
